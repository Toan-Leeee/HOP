@model MeetingScheduler.Web.ViewModels.Common.PagedResult<MeetingScheduler.Web.ViewModels.Meetings.RsvpTrackingViewModel>
@using MeetingScheduler.Web.ViewModels.Meetings
@{ViewData["Title"]="Phản hồi tham dự"; var meeting=ViewData["Meeting"] as MeetingDetailsViewModel; var filter=ViewData["Filter"] as RsvpFilter; var meetingId=meeting?.MeetingId ?? filter?.MeetingId ?? 0;}
<div class="page-heading"><div><div class="eyebrow">@meeting?.Title</div><h1>Phản hồi tham dự</h1></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@meetingId">Chi tiết cuộc họp</a></div>
<form method="get" class="filter-bar"><input type="hidden" name="MeetingId" value="@meetingId" /><div class="filter-field search"><label for="search" class="form-label">Tên hoặc email</label><input id="search" name="SearchString" value="@Context.Request.Query["SearchString"]" class="form-control" /></div><div class="filter-field"><label for="status" class="form-label">Phản hồi</label><select id="status" name="Status" class="form-select"><option value="">Tất cả</option>@foreach(var s in new[]{("Pending","Chưa phản hồi"),("Accepted","Tham dự"),("Declined","Từ chối")}){<option value="@s.Item1" selected="@(Context.Request.Query["Status"]==s.Item1)">@s.Item2</option>}</select></div><div class="filter-field"><label for="sort" class="form-label">Sắp xếp</label><select id="sort" name="SortOrder" class="form-select"><option value="">Tên A–Z</option><option value="status" selected="@(Context.Request.Query["SortOrder"]=="status")">Phản hồi</option><option value="responded" selected="@(Context.Request.Query["SortOrder"]=="responded")">Thời điểm phản hồi</option></select></div><button class="btn btn-primary">Lọc</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th scope="col">Nhân sự</th><th scope="col">Email</th><th scope="col">Phản hồi</th><th scope="col">Thời điểm</th></tr></thead><tbody>@foreach(var p in Model.Items){<tr><td class="primary-cell">@p.FullName</td><td>@p.Email</td><td><span class="status @(p.Status.ToString()=="Declined"?"status-danger":p.Status.ToString()=="Pending"?"status-warning":"")">@(p.Status.ToString()=="Accepted"?"Tham dự":p.Status.ToString()=="Declined"?"Từ chối":"Chưa phản hồi")</span></td><td>@(p.RespondedAt?.ToLocalTime().ToString("HH:mm · dd/MM/yyyy") ?? "—")</td></tr>}</tbody></table></div>@if(Model.Items.Count==0){<div class="empty-state">Không có phản hồi phù hợp.</div>}<partial name="/Views/Shared/_Pagination.cshtml" model="Model" />
