@model MeetingScheduler.Web.ViewModels.Meetings.MeetingDetailsViewModel
@using MeetingScheduler.Web.Models.Enums
@using System.Security.Claims
@{ ViewData["Title"]=Model.Title; var actor=User.FindFirstValue(ClaimTypes.NameIdentifier); var canManage=User.IsInRole("Admin") || (User.IsInRole("Organizer") && actor==Model.CreatedByUserId.ToString()); var active=Model.Status==MeetingStatus.Confirmed && Model.StartTime>DateTime.Now; var invited=int.TryParse(actor,out var actorId) && Model.ParticipantIds.Contains(actorId); }
<div class="page-heading"><h1>@Model.Title</h1><span class="status @(Model.Status==MeetingStatus.Cancelled?"status-danger":"")">@(Model.Status==MeetingStatus.Cancelled?"Đã hủy":"Đã xác nhận")</span></div>
<div class="editor"><dl class="detail-grid"><dt>Bắt đầu</dt><dd>@Model.StartTime.ToString("HH:mm · dd/MM/yyyy")</dd><dt>Kết thúc</dt><dd>@Model.EndTime.ToString("HH:mm · dd/MM/yyyy")</dd><dt>Phòng họp</dt><dd>@Model.RoomName</dd><dt>Người tổ chức</dt><dd>@Model.OrganizerName</dd><dt>Người tham dự</dt><dd>@Model.ParticipantCount người @if(canManage){<span>· <a asp-action="Rsvp" asp-route-id="@Model.MeetingId">Xem phản hồi</a></span>}</dd><dt>Nội dung</dt><dd class="preserve-lines">@Model.Description</dd>
@if(Model.Status==MeetingStatus.Cancelled){<dt>Lý do hủy</dt><dd class="preserve-lines">@Model.CancelReason</dd><dt>Thời điểm hủy</dt><dd>@Model.CancelledAt?.ToLocalTime().ToString("HH:mm · dd/MM/yyyy")</dd>}
</dl>
@if(active && invited){<section class="form-section"><h2>Phản hồi lời mời</h2><form asp-action="Respond" method="post" class="d-flex gap-2 flex-wrap"><input type="hidden" name="meetingId" value="@Model.MeetingId" /><button type="submit" class="btn btn-primary" name="status" value="Accepted">Tham dự</button><button type="submit" class="btn btn-outline-danger" name="status" value="Declined">Từ chối</button></form></section>}
<div class="form-actions">@if(canManage && active){<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.MeetingId">Chỉnh sửa</a><a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.MeetingId">Hủy cuộc họp</a>}<a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div></div>
