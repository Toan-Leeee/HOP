@model MeetingScheduler.Web.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<div class="auth-form"><div class="page-heading"><h1>Đặt lại mật khẩu</h1></div><form asp-action="ResetPassword" method="post"><div asp-validation-summary="All"></div><input asp-for="Email" type="hidden"/><input asp-for="Token" type="hidden"/><div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control"/><span asp-validation-for="NewPassword"></span></div><div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary w-100">Đặt lại mật khẩu</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
