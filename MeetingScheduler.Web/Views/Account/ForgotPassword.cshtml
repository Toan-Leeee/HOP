@model MeetingScheduler.Web.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="auth-form"><div class="page-heading"><h1>Quên mật khẩu</h1></div>
@if (TempData["ResetNotice"] is string notice) { <div class="alert alert-info">@notice</div> }
<form asp-action="ForgotPassword" method="post"><div asp-validation-summary="All"></div><div class="mb-3"><label asp-for="Email" class="form-label">Email tài khoản</label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><button class="btn btn-primary w-100">Gửi liên kết đặt lại</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
