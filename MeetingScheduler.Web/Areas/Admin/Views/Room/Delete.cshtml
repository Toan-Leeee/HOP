@model MeetingScheduler.Web.ViewModels.Rooms.RoomViewModel
@{ ViewData["Title"] = "Ngừng sử dụng phòng họp"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Ngừng sử dụng phòng họp</h1></div></div><div class="editor"><div class="alert alert-warning">Xác nhận ngừng sử dụng phòng họp <strong>@Model.RoomName</strong>? Dữ liệu lịch sử được giữ lại.</div><form asp-action="Delete" asp-route-id="@Model.RoomId" method="post"><input name="id" value="@Model.RoomId" type="hidden" /><div class="form-actions"><button class="btn btn-danger">Xác nhận ngừng sử dụng</button><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div></form></div>
