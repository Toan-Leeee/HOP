@model MeetingScheduler.Web.ViewModels.Rooms.RoomViewModel
@{ ViewData["Title"] = "Chi tiết phòng họp"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Chi tiết phòng họp</h1></div></div><div class="editor"><dl class="detail-grid"><dt>Tên phòng</dt><dd>@Model.RoomName</dd><dt>Vị trí</dt><dd>@Model.Location</dd><dt>Sức chứa</dt><dd>@Model.Capacity</dd><dt>Trang thiết bị</dt><dd>@Model.Equipment</dd><dt>Sử dụng</dt><dd><span class="status @(Model.IsDisabled ? "status-neutral" : "")">@(Model.IsDisabled ? "Đã ngừng sử dụng" : "Đang sử dụng")</span></dd></dl><div class="form-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.RoomId">Chỉnh sửa</a><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div></div>
