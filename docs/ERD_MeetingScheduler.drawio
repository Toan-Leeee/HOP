        <mxCell id="legend" value="&lt;b&gt;CHÚ GIẢI&lt;/b&gt;  PK: khóa chính · FK: khóa ngoại · UK: duy nhất · ?: cho phép NULL&lt;br/&gt;1: đúng một · 0..1: không có hoặc một · 0..n: không có hoặc nhiều bản ghi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#243347;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1280" width="1410" height="58" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;QUAN HỆ VÀ RÀNG BUỘC&lt;/b&gt;&lt;br/&gt;Meeting n–n User qua MeetingParticipant; khóa chính ghép (MeetingId, UserId).&lt;br/&gt;Meeting.EndTime &amp;gt; StartTime; Room.Capacity &amp;gt; 0. User/Room/Department xóa mềm bằng IsDisabled.&lt;br/&gt;Meeting.Status: Confirmed / Cancelled; Room.Status: Active / Maintenance; RSVP: Pending / Accepted / Declined.&lt;br/&gt;AuditLog.EntityId là tham chiếu logic theo EntityName, không phải FK tới một bảng cố định. EmailQueue được lưu độc lập để worker xử lý hàng đợi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#243347;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1350" width="1410" height="130" />
        </mxCell>
