@model MeetingScheduler.Web.ViewModels.Users.UserEditViewModel
@{ ViewData["Title"] = "Chi tiết nhân sự"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Chi tiết nhân sự</h1></div></div><div class="editor"><dl class="detail-grid"><dt>Họ và tên</dt><dd>@Model.FullName</dd><dt>Email</dt><dd>@Model.Email</dd><dt>Số điện thoại</dt><dd>@Model.Phone</dd><dt>Phòng ban</dt><dd>@Model.DepartmentName</dd><dt>Vai trò</dt><dd>@Model.RoleName</dd><dt>Sử dụng</dt><dd><span class="status @(Model.IsDisabled ? "status-neutral" : "")">@(Model.IsDisabled ? "Đã ngừng sử dụng" : "Đang sử dụng")</span></dd></dl><div class="form-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.UserId">Chỉnh sửa</a><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div></div>
