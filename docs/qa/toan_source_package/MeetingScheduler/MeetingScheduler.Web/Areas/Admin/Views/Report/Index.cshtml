@model MeetingScheduler.Web.ViewModels.Reports.ReportResult
@using System.Globalization
@{ ViewData["Title"]="Báo cáo sử dụng phòng"; var maxHours=Model.Rooms.Count==0 ? 1 : Math.Max(1,Model.Rooms.Max(x=>x.TotalHours)); var culture=CultureInfo.GetCultureInfo("vi-VN"); }
<div class="page-heading"><h1>Báo cáo sử dụng phòng</h1><button type="button" class="btn btn-outline-secondary no-print" data-print><i data-lucide="printer" aria-hidden="true"></i> In báo cáo</button></div>
<div asp-validation-summary="All"></div>
<form method="get" class="filter-bar"><div class="filter-field"><label class="form-label" for="from">Từ thời điểm</label><input id="from" name="From" type="datetime-local" value="@Model.Filter.From.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /></div><div class="filter-field"><label class="form-label" for="to">Đến thời điểm</label><input id="to" name="To" type="datetime-local" value="@Model.Filter.To.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /></div><div class="filter-field"><label class="form-label" for="room">Phòng họp</label><select id="room" name="RoomId" class="form-select"><option value="">Tất cả</option>@foreach(var room in (ViewData["Rooms"] as IEnumerable<LookupItem> ?? [])){<option value="@room.Id" selected="@(Model.Filter.RoomId==room.Id)">@room.Name</option>}</select></div><button type="submit" class="btn btn-primary">Xem báo cáo</button></form>
<div class="metric-row"><div><span class="metric-value">@Model.TotalMeetings</span><span class="metric-label">Tổng cuộc họp</span></div><div><span class="metric-value text-danger">@Model.CancelledMeetings</span><span class="metric-label">Cuộc họp đã hủy</span></div><div><span class="metric-value text-success">@Model.AcceptedResponses</span><span class="metric-label">Phản hồi tham dự</span></div><div><span class="metric-value text-warning-emphasis">@Model.PendingResponses</span><span class="metric-label">Chưa phản hồi</span></div></div>
<h2 class="mb-3">Thời lượng sử dụng theo phòng</h2>
<div class="report-bars">@foreach(var room in Model.Rooms){<div class="report-bar-row"><span>@room.RoomName</span><div class="report-track"><div class="report-fill" style="width:@((room.TotalHours/maxHours*100).ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><strong>@room.TotalHours.ToString("0.##",culture) giờ</strong></div>}</div>
<div class="table-responsive mt-4"><table class="table"><thead><tr><th scope="col">Phòng họp</th><th scope="col">Cuộc họp</th><th scope="col">Tổng thời lượng</th></tr></thead><tbody>@foreach(var room in Model.Rooms){<tr><td class="primary-cell">@room.RoomName</td><td>@room.MeetingCount</td><td>@room.TotalHours.ToString("0.##",culture) giờ</td></tr>}</tbody></table></div>@if(Model.Rooms.Count==0){<div class="empty-state">Không có dữ liệu trong khoảng thời gian đã chọn.</div>}
<p class="text-muted mt-3">Phản hồi từ chối: @Model.DeclinedResponses</p>
