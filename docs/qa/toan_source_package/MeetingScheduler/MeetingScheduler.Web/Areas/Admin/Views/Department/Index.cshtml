@model PagedResult<MeetingScheduler.Web.ViewModels.Departments.DepartmentViewModel>
@{ ViewData["Title"] = "Phòng ban"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Phòng ban</h1></div><a class="btn btn-primary" asp-action="Create">Thêm phòng ban</a></div><form method="get" class="filter-bar"><div class="filter-field search"><label for="search" class="form-label">Tìm kiếm</label><input id="search" name="SearchString" value="@Context.Request.Query["SearchString"]" class="form-control" placeholder="Nhập từ khóa" /></div><div class="filter-field"><label for="disabled" class="form-label">Trạng thái sử dụng</label><select id="disabled" name="IsDisabled" class="form-select"><option value="false" selected="@(Context.Request.Query["IsDisabled"] != "true")">Đang sử dụng</option><option value="true" selected="@(Context.Request.Query["IsDisabled"] == "true")">Đã ngừng sử dụng</option></select></div><div class="filter-field"><label for="sort" class="form-label">Sắp xếp</label><select id="sort" name="SortOrder" class="form-select"><option value="" selected="@(Context.Request.Query["SortOrder"] == "")">Tên A–Z</option><option value="name_desc" selected="@(Context.Request.Query["SortOrder"] == "name_desc")">Tên Z–A</option></select></div><div class="filter-field"><label for="pageSize" class="form-label">Số dòng</label><select id="pageSize" name="PageSize" class="form-select">@foreach(var n in new[] {10,20,50}) { <option value="@n" selected="@(Context.Request.Query["PageSize"] == n.ToString())">@n</option> }</select></div><button class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a></form><div class="table-responsive"><table class="table"><thead><tr><th scope="col">Tên phòng ban</th><th scope="col">Trạng thái</th><th scope="col"></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td class="primary-cell">@item.DepartmentName</td><td><span class="status @(item.IsDisabled ? "status-neutral" : "")">@(item.IsDisabled ? "Đã ngừng sử dụng" : "Đang sử dụng")</span></td><td><div class="row-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.DepartmentId">Chi tiết</a><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.DepartmentId">Sửa</a>@if(!item.IsDisabled){<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.DepartmentId">Ngừng dùng</a>}else{<form asp-action="Restore" asp-route-id="@item.DepartmentId" method="post" data-confirm="Khôi phục mục này?"><button class="btn btn-sm btn-outline-success">Khôi phục</button></form>}</div></td></tr>}</tbody></table></div>@if(Model.Items.Count==0){<div class="empty-state">Không có phòng ban phù hợp.</div>}<partial name="/Views/Shared/_Pagination.cshtml" model="Model" />
