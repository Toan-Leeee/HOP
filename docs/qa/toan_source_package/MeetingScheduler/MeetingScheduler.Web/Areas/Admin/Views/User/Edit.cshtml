@model MeetingScheduler.Web.ViewModels.Users.UserEditViewModel
@{ ViewData["Title"] = "Chỉnh sửa nhân sự"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Chỉnh sửa nhân sự</h1></div></div><form asp-action="Edit" method="post" class="editor"><div asp-validation-summary="All"></div><input asp-for="UserId" type="hidden" /><section class="form-section"><div class="mb-3"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" type="text" class="form-control" /><span asp-validation-for="FullName"></span></div><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="mb-3"><label asp-for="Phone" class="form-label">Số điện thoại</label><input asp-for="Phone" type="tel" class="form-control" /><span asp-validation-for="Phone"></span></div><div class="mb-3"><label asp-for="DepartmentId" class="form-label">Phòng ban</label><select asp-for="DepartmentId" class="form-select"><option value="">Chọn phòng ban</option>@foreach(var item in (ViewData["Departments"] as IEnumerable<MeetingScheduler.Web.ViewModels.Common.LookupItem> ?? [])) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="DepartmentId"></span></div><div class="mb-3"><label asp-for="RoleId" class="form-label">Vai trò</label><select asp-for="RoleId" class="form-select"><option value="">Chọn vai trò</option>@foreach(var item in (ViewData["Roles"] as IEnumerable<MeetingScheduler.Web.ViewModels.Common.LookupItem> ?? [])) { <option value="@item.Id">@item.Name</option> }</select><span asp-validation-for="RoleId"></span></div><div class="form-check mb-3"><input asp-for="IsDisabled" class="form-check-input" /><label asp-for="IsDisabled" class="form-check-label">Ngừng sử dụng</label></div></section><div class="form-actions"><button type="submit" class="btn btn-primary">Lưu thay đổi</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
