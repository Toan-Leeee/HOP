@model MeetingScheduler.Web.ViewModels.Common.PagedResult<MeetingScheduler.Web.ViewModels.Meetings.MeetingDetailsViewModel>
@using MeetingScheduler.Web.ViewModels.Common
@using MeetingScheduler.Web.Models.Enums
@{ ViewData["Title"]="Cuộc họp"; }
<div class="page-heading"><div><div class="eyebrow">@DateTime.Today.ToString("dd/MM/yyyy")</div><h1>Cuộc họp</h1></div><div class="d-flex gap-2 flex-wrap"><div class="btn-group" role="group" aria-label="Chế độ xem"><button class="btn btn-outline-secondary active" type="button" data-meeting-mode="list" aria-pressed="true">Danh sách</button><button class="btn btn-outline-secondary" type="button" data-meeting-mode="calendar" aria-pressed="false">Lịch tuần</button></div>@if(User.IsInRole("Admin") || User.IsInRole("Organizer")){<a class="btn btn-primary" asp-area="" asp-controller="Meeting" asp-action="Create">Tạo cuộc họp</a>}</div></div>
<div id="meeting-list">
<form method="get" class="filter-bar"><div class="filter-field search"><label for="search" class="form-label">Tìm kiếm</label><input id="search" name="SearchString" value="@Context.Request.Query["SearchString"]" class="form-control" placeholder="Nhập từ khóa" /></div><div class="filter-field"><label for="room" class="form-label">Phòng họp</label><select id="room" name="RoomId" class="form-select"><option value="">Tất cả</option>@foreach(var r in (ViewData["Rooms"] as IEnumerable<LookupItem> ?? [])){<option value="@r.Id" selected="@(Context.Request.Query["RoomId"]==r.Id.ToString())">@r.Name</option>}</select></div><div class="filter-field"><label for="status" class="form-label">Trạng thái</label><select id="status" name="Status" class="form-select"><option value="">Tất cả</option><option value="Confirmed" selected="@(Context.Request.Query["Status"]=="Confirmed")">Đã xác nhận</option><option value="Cancelled" selected="@(Context.Request.Query["Status"]=="Cancelled")">Đã hủy</option></select></div><div class="filter-field"><label for="from" class="form-label">Từ ngày</label><input type="datetime-local" name="From" id="from" class="form-control" value="@Context.Request.Query["From"]" /></div><div class="filter-field"><label for="to" class="form-label">Đến ngày</label><input type="datetime-local" name="To" id="to" class="form-control" value="@Context.Request.Query["To"]" /></div><div class="filter-field"><label for="sort" class="form-label">Sắp xếp</label><select id="sort" name="SortOrder" class="form-select"><option value="" selected="@(Context.Request.Query["SortOrder"] == "")">Mới nhất</option><option value="start" selected="@(Context.Request.Query["SortOrder"] == "start")">Thời gian tăng</option><option value="title" selected="@(Context.Request.Query["SortOrder"] == "title")">Tiêu đề A–Z</option><option value="title_desc" selected="@(Context.Request.Query["SortOrder"] == "title_desc")">Tiêu đề Z–A</option></select></div><div class="filter-field"><label for="pageSize" class="form-label">Số dòng</label><select id="pageSize" name="PageSize" class="form-select">@foreach(var n in new[] {10,20,50}) { <option value="@n" selected="@(Context.Request.Query["PageSize"] == n.ToString())">@n</option> }</select></div><button class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a></form>
<div class="table-responsive"><table class="table"><thead><tr><th scope="col">Cuộc họp</th><th scope="col">Thời gian</th><th scope="col">Phòng họp</th><th scope="col">Người tổ chức</th><th scope="col">Trạng thái</th><th scope="col"></th></tr></thead><tbody>
@foreach(var item in Model.Items){<tr><td class="primary-cell"><a asp-area="" asp-controller="Meeting" asp-action="Details" asp-route-id="@item.MeetingId">@item.Title</a><small>@item.ParticipantCount người tham dự</small></td><td>@item.StartTime.ToString("dd/MM/yyyy")<small>@item.StartTime.ToString("HH:mm") – @item.EndTime.ToString("HH:mm dd/MM")</small></td><td>@item.RoomName</td><td>@item.OrganizerName</td><td><span class="status @(item.Status==MeetingStatus.Cancelled ? "status-danger" : "")">@(item.Status==MeetingStatus.Cancelled ? "Đã hủy" : "Đã xác nhận")</span></td><td><a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Meeting" asp-action="Details" asp-route-id="@item.MeetingId">Chi tiết</a></td></tr>}
</tbody></table></div>@if(Model.Items.Count==0){<div class="empty-state">Chưa có cuộc họp phù hợp.</div>}<partial name="/Views/Shared/_Pagination.cshtml" model="Model" />
</div>
<section id="meeting-calendar" hidden data-calendar-url="@Url.Content("~/api/meetings")" data-details-url="@Url.Action("Details","Meeting",new {area=""})">
<div class="calendar-toolbar"><div class="d-flex gap-2"><button class="btn btn-outline-secondary icon-button" type="button" data-calendar-prev aria-label="Tuần trước" title="Tuần trước"><i data-lucide="chevron-left" aria-hidden="true"></i></button><button class="btn btn-outline-secondary" type="button" data-calendar-today>Hôm nay</button><button class="btn btn-outline-secondary icon-button" type="button" data-calendar-next aria-label="Tuần sau" title="Tuần sau"><i data-lucide="chevron-right" aria-hidden="true"></i></button></div><h2 class="mb-0" data-calendar-title></h2></div>
<div data-calendar-status role="status" class="text-muted mb-3"></div><div class="week-grid" data-calendar-grid></div>
</section>
@section Scripts { <script src="~/js/calendar.js" asp-append-version="true"></script> }
