@model MeetingScheduler.Web.ViewModels.Rooms.RoomViewModel
@{ ViewData["Title"] = "Chỉnh sửa phòng họp"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Chỉnh sửa phòng họp</h1></div></div><form asp-action="Edit" method="post" class="editor"><div asp-validation-summary="All"></div><input asp-for="RoomId" type="hidden" /><section class="form-section"><div class="mb-3"><label asp-for="RoomName" class="form-label">Tên phòng họp</label><input asp-for="RoomName" type="text" class="form-control" /><span asp-validation-for="RoomName"></span></div><div class="mb-3"><label asp-for="Location" class="form-label">Vị trí</label><input asp-for="Location" type="text" class="form-control" /><span asp-validation-for="Location"></span></div><div class="mb-3"><label asp-for="Capacity" class="form-label">Sức chứa</label><input asp-for="Capacity" type="number" class="form-control" /><span asp-validation-for="Capacity"></span></div><div class="mb-3"><label asp-for="Equipment" class="form-label">Trang thiết bị</label><textarea asp-for="Equipment" class="form-control" rows="3"></textarea><span asp-validation-for="Equipment"></span></div><div class="mb-3"><label asp-for="Status" class="form-label">Trạng thái phòng</label><select asp-for="Status" class="form-select"><option value="Active">Sẵn sàng</option><option value="Maintenance">Bảo trì</option></select></div><div class="form-check mb-3"><input asp-for="IsDisabled" class="form-check-input" /><label asp-for="IsDisabled" class="form-check-label">Ngừng sử dụng</label></div></section><div class="form-actions"><button type="submit" class="btn btn-primary">Lưu thay đổi</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
