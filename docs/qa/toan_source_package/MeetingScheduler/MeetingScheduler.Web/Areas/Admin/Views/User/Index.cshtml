@model PagedResult<MeetingScheduler.Web.ViewModels.Users.UserEditViewModel>
@{ ViewData["Title"] = "Nhân sự"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Nhân sự</h1></div><a class="btn btn-primary" asp-action="Create">Thêm nhân sự</a></div><form method="get" class="filter-bar"><div class="filter-field search"><label for="search" class="form-label">Tìm kiếm</label><input id="search" name="SearchString" value="@Context.Request.Query["SearchString"]" class="form-control" placeholder="Nhập từ khóa" /></div><div class="filter-field"><label for="department" class="form-label">Phòng ban</label><select id="department" name="DepartmentId" class="form-select"><option value="">Tất cả</option>@foreach(var d in (ViewData["Departments"] as IEnumerable<LookupItem> ?? [])){<option value="@d.Id" selected="@(Context.Request.Query["DepartmentId"] == d.Id.ToString())">@d.Name</option>}</select></div><div class="filter-field"><label for="role" class="form-label">Vai trò</label><select id="role" name="RoleId" class="form-select"><option value="">Tất cả</option><option value="1" selected="@(Context.Request.Query["RoleId"]=="1")">Quản trị viên</option><option value="2" selected="@(Context.Request.Query["RoleId"]=="2")">Người tổ chức</option><option value="3" selected="@(Context.Request.Query["RoleId"]=="3")">Nhân viên</option></select></div><div class="filter-field"><label for="disabled" class="form-label">Trạng thái sử dụng</label><select id="disabled" name="IsDisabled" class="form-select"><option value="false" selected="@(Context.Request.Query["IsDisabled"] != "true")">Đang sử dụng</option><option value="true" selected="@(Context.Request.Query["IsDisabled"] == "true")">Đã ngừng sử dụng</option></select></div><div class="filter-field"><label for="sort" class="form-label">Sắp xếp</label><select id="sort" name="SortOrder" class="form-select"><option value="" selected="@(Context.Request.Query["SortOrder"] == "")">Tên A–Z</option><option value="name_desc" selected="@(Context.Request.Query["SortOrder"] == "name_desc")">Tên Z–A</option><option value="email" selected="@(Context.Request.Query["SortOrder"] == "email")">Email A–Z</option><option value="email_desc" selected="@(Context.Request.Query["SortOrder"] == "email_desc")">Email Z–A</option></select></div><div class="filter-field"><label for="pageSize" class="form-label">Số dòng</label><select id="pageSize" name="PageSize" class="form-select">@foreach(var n in new[] {10,20,50}) { <option value="@n" selected="@(Context.Request.Query["PageSize"] == n.ToString())">@n</option> }</select></div><button class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a></form><div class="table-responsive"><table class="table"><thead><tr><th scope="col">Nhân sự</th><th scope="col">Phòng ban</th><th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col"></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td class="primary-cell">@item.FullName<small>@item.Email</small></td><td>@item.DepartmentName</td><td>@(item.RoleId==1 ? "Quản trị viên" : item.RoleId==2 ? "Người tổ chức" : "Nhân viên")</td><td><span class="status @(item.IsDisabled ? "status-danger" : "")">@(item.IsDisabled ? "Đã khóa" : "Hoạt động")</span></td><td><div class="row-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.UserId">Chi tiết</a><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.UserId">Sửa</a>@if(!item.IsDisabled){<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.UserId">Ngừng dùng</a>}else{<form asp-action="Restore" asp-route-id="@item.UserId" method="post" data-confirm="Khôi phục mục này?"><button class="btn btn-sm btn-outline-success">Khôi phục</button></form>}</div></td></tr>}</tbody></table></div>@if(Model.Items.Count==0){<div class="empty-state">Không có nhân sự phù hợp.</div>}<partial name="/Views/Shared/_Pagination.cshtml" model="Model" />
