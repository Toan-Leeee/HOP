@model MeetingScheduler.Web.ViewModels.Departments.DepartmentViewModel
@{ ViewData["Title"] = "Chi tiết phòng ban"; }
<div class="page-heading"><div><div class="eyebrow">Không gian làm việc</div><h1>Chi tiết phòng ban</h1></div></div><div class="editor"><dl class="detail-grid"><dt>Tên phòng ban</dt><dd>@Model.DepartmentName</dd><dt>Sử dụng</dt><dd><span class="status @(Model.IsDisabled ? "status-neutral" : "")">@(Model.IsDisabled ? "Đã ngừng sử dụng" : "Đang sử dụng")</span></dd></dl><div class="form-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.DepartmentId">Chỉnh sửa</a><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div></div>
