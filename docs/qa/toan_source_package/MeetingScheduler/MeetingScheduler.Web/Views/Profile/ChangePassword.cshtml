@model MeetingScheduler.Web.ViewModels.Account.ChangePasswordViewModel
@{ViewData["Title"]="Đổi mật khẩu";}
<div class="page-heading"><h1>Đổi mật khẩu</h1></div><form class="editor" asp-action="ChangePassword" method="post"><div asp-validation-summary="All"></div><section class="form-section">
<div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" class="form-control" /><span asp-validation-for="CurrentPassword"></span></div>
<div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="NewPassword"></span></div>
<div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="ConfirmPassword"></span></div>
</section><div class="form-actions"><button type="submit" class="btn btn-primary">Đổi mật khẩu</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
