@model MeetingScheduler.Web.ViewModels.Account.ProfileViewModel
@{ViewData["Title"]="Hồ sơ cá nhân";}
<div class="page-heading"><h1>Hồ sơ cá nhân</h1><a asp-action="ChangePassword" class="btn btn-outline-secondary">Đổi mật khẩu</a></div><form class="editor" asp-action="Index" method="post"><div asp-validation-summary="All"></div><section class="form-section"><div class="mb-3"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" type="text" class="form-control" /><span asp-validation-for="FullName"></span></div><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="mb-3"><label asp-for="Phone" class="form-label">Số điện thoại</label><input asp-for="Phone" type="tel" class="form-control" /><span asp-validation-for="Phone"></span></div></section><div class="form-actions"><button type="submit" class="btn btn-primary">Lưu hồ sơ</button><a asp-controller="Meeting" asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
