@{ var c = ViewContext.RouteData.Values["controller"]?.ToString(); var a = ViewContext.RouteData.Values["area"]?.ToString() ?? ""; }
<!DOCTYPE html>
<html lang="vi">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] | Lịch họp</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<header class="app-header"><nav class="navbar navbar-expand-lg container-fluid" aria-label="Điều hướng chính">
<a class="navbar-brand" asp-area="" asp-controller="Meeting" asp-action="Index"><span class="brand-mark">M</span> Lịch họp</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#app-nav" aria-controls="app-nav" aria-expanded="false" aria-label="Mở điều hướng"><span class="navbar-toggler-icon"></span></button>
<div id="app-nav" class="collapse navbar-collapse"><div class="navbar-nav me-auto">
<a class="nav-link @(c == "Meeting" && a == "" ? "active" : "")" asp-area="" asp-controller="Meeting" asp-action="Index">Cuộc họp</a>
@if(User.IsInRole("Admin")) {
@foreach(var item in new[] { ("Room", "Phòng họp"), ("Department", "Phòng ban"), ("User", "Nhân sự"), ("Meeting", "Quản lý lịch"), ("Report", "Báo cáo") }) {
<a class="nav-link @(c == item.Item1 && a == "Admin" ? "active" : "")" asp-area="Admin" asp-controller="@item.Item1" asp-action="Index">@item.Item2</a>
}}
</div><div class="navbar-nav align-items-lg-center gap-2">
@if(User.Identity?.IsAuthenticated == true) {
<a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Index">@(User.Identity.Name ?? "Hồ sơ")</a>
<form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary">Đăng xuất</button></form>
} else { <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a> }
</div></div></nav></header>
<main id="main-content" class="app-main" tabindex="-1">
@foreach(var key in new[] { "Success", "Error", "Warning", "Message" }) {
if(TempData[key] is string message) { <div class="alert @(key == "Error" ? "alert-danger" : key == "Warning" ? "alert-warning" : "alert-success") alert-dismissible fade show" role="alert">@message<button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Đóng"></button></div> }
}
@RenderBody()
</main><footer class="app-footer">Lịch họp doanh nghiệp <span>Meeting Scheduler</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/lucide.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
